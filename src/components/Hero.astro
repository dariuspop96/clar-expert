---
import Button from './ui/Button.astro';
import Icon, { type IconName } from './ui/Icon.astro';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const trust: { icon: IconName; key: string }[] = [
  { icon: 'shield-check', key: 'ceccar' },
  { icon: 'chart-line', key: 'reports' },
  { icon: 'clock', key: 'response' },
  { icon: 'building', key: 'group' },
];

const cardItems = ['item1', 'item2', 'item3', 'item4'] as const;
const cardIcons: IconName[] = ['document', 'declaration', 'chart-bars', 'people'];
---

<section class="hero" id="acasa">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="section-label">
        <span class="hero__rule" aria-hidden="true"></span>
        {t('hero.label')}
      </span>

      <h1 class="hero__title">{t('hero.title')}</h1>
      <p class="hero__lead">{t('hero.lead')}</p>

      <div class="hero__actions">
        <Button href="#oferta" variant="primary">{t('hero.ctaPrimary')}</Button>
        <Button href="#servicii" variant="outline">{t('hero.ctaSecondary')}</Button>
      </div>

      <ul class="hero__trust">
        {
          trust.map(({ icon, key }) => (
            <li class="trust">
              <Icon name={icon} size={22} stroke={1.6} class="trust__icon" />
              <div>
                <strong class="trust__title">{t(`hero.trust.${key}.title`)}</strong>
                <span class="trust__desc">{t(`hero.trust.${key}.desc`)}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="panel">
      <p class="panel__title">{t('hero.card.title')}</p>
      <ul class="panel__list">
        {
          cardItems.map((item, index) => (
            <li class="panel__item">
              <span class="panel__icon">
                <Icon name={cardIcons[index]} size={19} stroke={1.6} />
              </span>
              <span class="panel__text">{t(`hero.card.${item}`)}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #fff 0%, #EEF7FC 100%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    padding-block: 76px 90px;
  }

  .hero__rule { width: 26px; height: 2px; background: var(--c-brand); }

  .hero__title {
    margin-top: 22px;
    font-size: var(--fs-h1);
  }

  .hero__lead {
    max-width: 520px;
    margin: 22px 0 0;
    font-size: var(--fs-lead);
    color: var(--c-body);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .hero__trust {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 28px;
    max-width: 520px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .trust { display: flex; gap: 12px; align-items: flex-start; }
  .trust :global(.trust__icon) { flex: none; margin-top: 2px; color: var(--c-brand); }
  .trust__title { display: block; font-size: 14.5px; color: var(--c-heading); }
  .trust__desc { font-size: 13px; color: var(--c-muted); }

  /* Caseta antracit */
  .panel {
    position: relative;
    overflow: hidden;
    padding: 34px;
    border-radius: var(--r-2xl);
    background: var(--c-ink);
    box-shadow: 0 30px 60px -28px rgb(35 42 49 / 0.55);
  }
  .panel::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(37 162 212 / 0.55), transparent 70%);
  }

  .panel__title {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: 15px;
    color: #EAF6FC;
  }

  .panel__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .panel__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 15px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.05);
  }

  .panel__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: rgb(37 162 212 / 0.18);
    color: var(--c-brand-light);
  }

  .panel__text {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--c-on-ink);
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 48px 60px;
    }
  }

  @media (max-width: 640px) {
    .hero__trust { grid-template-columns: 1fr; }
  }
</style>
