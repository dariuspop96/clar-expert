---
import Footer from './Footer.astro';
import Header from './Header.astro';
import { localizePath, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
  path: string;
  titleKey: 'privacyTitle' | 'cookiesTitle' | 'termsTitle';
}

const { locale, path, titleKey } = Astro.props;
const t = useTranslations(locale);
---

<Header locale={locale} path={path} />
<main class="legal" id="main">
  <div class="container legal__inner">
    <h1 class="legal__title">{t(`legal.${titleKey}`)}</h1>
    <div class="legal__body">
      <slot>
        <p class="legal__todo">{t('legal.todo')}</p>
      </slot>
    </div>
    <a class="legal__back" href={localizePath('/', locale)}>← {t('legal.backHome')}</a>
  </div>
</main>
<Footer locale={locale} />

<style>
  .legal { padding-block: 64px 90px; }
  .legal__inner { max-width: 760px; }
  .legal__title { font-size: var(--fs-h2); }
  .legal__body { margin-top: 28px; }

  .legal__todo {
    padding: 16px 18px;
    border: 1px solid #F0DCC8;
    border-radius: var(--r-md);
    background: #FCF5EC;
    color: #8A5A21;
    font-size: 14.5px;
  }

  .legal__back {
    display: inline-block;
    margin-top: 40px;
    font-size: 14.5px;
    font-weight: 500;
  }
</style>
